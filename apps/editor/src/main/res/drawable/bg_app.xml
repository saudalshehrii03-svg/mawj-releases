<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#FF0B0A14" android:centerColor="#FF0D0B1A" android:endColor="#FF07070C" />
        </shape>
    </item>
    <item android:width="460dp" android:height="460dp" android:gravity="top|start" android:left="-170dp" android:top="-150dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="230dp" android:startColor="#66FF2D7A" android:endColor="#00FF2D7A" />
        </shape>
    </item>
    <item android:width="420dp" android:height="420dp" android:gravity="top|end" android:right="-180dp" android:top="120dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="210dp" android:startColor="#558B5CF6" android:endColor="#008B5CF6" />
        </shape>
    </item>
    <item android:width="480dp" android:height="480dp" android:gravity="bottom|start" android:left="-120dp" android:bottom="-200dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="240dp" android:startColor="#4425F4EE" android:endColor="#0025F4EE" />
        </shape>
    </item>
</layer-list>

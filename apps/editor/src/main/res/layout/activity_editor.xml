<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/glass_ripple_circle"
            android:contentDescription="رجوع"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/undoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/glass_ripple_circle"
            android:contentDescription="تراجع"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/redoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/glass_ripple_circle"
            android:contentDescription="إعادة"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_redo" />

        <TextView
            android:id="@+id/exportButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_gradient"
            android:clickable="true"
            android:drawableStart="@drawable/i_export"
            android:drawablePadding="6dp"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="تصدير"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Preview -->
    <FrameLayout
        android:id="@+id/previewCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="14dp"
        android:layout_weight="1"
        android:background="@drawable/glass_card"
        android:clipToOutline="true"
        android:padding="1dp">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:shutter_background_color="#00000000"
            app:use_controller="false" />

        <TextView
            android:id="@+id/previewHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:padding="24dp"
            android:text="🎬\nأضف مقاطع أو صور للبدء"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/bridgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/glass_pill"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="✨ جاري تجهيز الدمج…"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Transport -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layoutDirection="ltr"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:background="@drawable/glass_pill"
            android:fontFeatureSettings="tnum"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="00:00.00"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/accent_circle"
            android:contentDescription="تشغيل"
            android:elevation="6dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <TextView
            android:id="@+id/durationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:fontFeatureSettings="tnum"
            android:text="00:00.00"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- Timeline -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/glass_panel"
        android:clipToOutline="true"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <com.mawj.editor.ui.TimelineView
            android:id="@+id/timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <!-- Context label + tools -->
    <TextView
        android:id="@+id/toolsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:textColor="#99FFFFFF"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/glass_panel"
        android:clipToOutline="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="10dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp" />
    </HorizontalScrollView>
</LinearLayout>

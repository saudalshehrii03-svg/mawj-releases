<resources>
    <style name="Theme.MawjEdit" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#3A1020</item>
        <item name="colorSecondary">@color/accent2</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">#FF0B0A14</item>
        <item name="android:navigationBarColor">#FF07070C</item>
        <item name="materialAlertDialogTheme">@style/MawjDialog</item>
        <item name="bottomSheetDialogTheme">@style/MawjSheet</item>
    </style>
    <style name="MawjSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent2</item>
        <item name="bottomSheetStyle">@style/MawjSheetStyle</item>
    </style>
    <style name="MawjSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    <style name="MawjDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="colorSurface">#1C1A2A</item>
        <item name="colorSurfaceContainerHigh">#1C1A2A</item>
    </style>
</resources>

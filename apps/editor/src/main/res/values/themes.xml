<resources>
    <style name="Theme.MawjEdit" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="materialAlertDialogTheme">@style/MawjDialog</item>
        <item name="bottomSheetDialogTheme">@style/MawjSheet</item>
    </style>
    <style name="MawjSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="bottomSheetStyle">@style/MawjSheetStyle</item>
        <item name="android:navigationBarColor">@color/sheet</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>
    <style name="MawjSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    <style name="MawjDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
    </style>
</resources>
